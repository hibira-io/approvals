{
  "name": "@hibira-io/approvals",
  "version": "0.1.0",
  "description": "Human approvals for AI agents over Hibira realtime channels: tool-call approval inbox for the Vercel AI SDK, Mastra and LangGraph, with React and Vue components",
  "keywords": [
    "ai",
    "agents",
    "human-in-the-loop",
    "hitl",
    "approval",
    "tool-calling",
    "ai-sdk",
    "vercel-ai-sdk",
    "mastra",
    "langgraph",
    "react",
    "vue",
    "pusher",
    "realtime",
    "hibira"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/approvals/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/approvals.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./ai-sdk": {
      "types": "./ai-sdk.d.ts",
      "default": "./ai-sdk.js"
    },
    "./mastra": {
      "types": "./mastra.d.ts",
      "default": "./mastra.js"
    },
    "./langgraph": {
      "types": "./langgraph.d.ts",
      "default": "./langgraph.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "handler.js",
    "ai-sdk.js",
    "ai-sdk.d.ts",
    "mastra.js",
    "mastra.d.ts",
    "langgraph.js",
    "langgraph.d.ts",
    "client.js",
    "client.d.ts",
    "inbox.js",
    "view.js",
    "locales.js",
    "react.js",
    "react.d.ts",
    "vue.js",
    "vue.d.ts",
    "types.d.ts",
    "styles.css",
    "PROTOCOL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "pusher-js": ">=7",
    "react": ">=17",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "pusher-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@mastra/core": "^1.81.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "ai": "^7.0.159",
    "jsdom": "^30.1.3",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  }
}
